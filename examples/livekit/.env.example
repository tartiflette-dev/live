# Copy to .env next to compose.yaml, fill in, keep it out of version control.

# Public names; both must resolve to this host before the first start
# (Caddy requests their certificates).
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com

# Public URL of the app: LiveKit sends its webhooks to $APP_URL/webhooks/livekit.
APP_URL=https://live.example.com

# Generate with: docker run --rm livekit/livekit-server:v1.13.5 generate-keys
# The app needs the same pair (LIVEKIT_API_KEY / LIVEKIT_API_SECRET).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# Host directory for recordings, shared with the app (RECORDINGS_ROOT).
RECORDINGS_DIR=/srv/live/recordings

# Optional: the public IPv4 address to announce. Empty: discovered through STUN.
NODE_IP=
