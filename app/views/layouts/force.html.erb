<%# Layout hors-session (connexion, pages d'erreur) : l'anonyme ne voit
    AUCUN chrome de session (ni déconnexion, ni navigation animateur). %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <%= theme_color_meta_tag %>
    <meta name="application-name" content="<%= Brand.product_name %>">
    <title><%= Brand.product_name %></title>
    <%= render "theme/anti_fouc" %>
    <%= theme_fonts_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render "shared/favicon" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="<%= content_for(:body_class).presence || "connexion-body" %>">
    <%= yield %>
  </body>
</html>
